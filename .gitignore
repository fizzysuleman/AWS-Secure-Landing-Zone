# Terraform working directories and state
**/.terraform/*
*.tfstate
*.tfstate.*

# Terraform plans and variable files that may contain secrets
*.tfplan
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
*.pem
*.key
*.p12
*.pfx
secrets.*

# Terraform-generated dependency lock override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local CLI configuration and crash logs
.terraformrc
terraform.rc
crash.log
crash.*.log
.terraform.tfstate.lock.info

# Common operating-system and editor files
.DS_Store
.idea/
.vscode/
